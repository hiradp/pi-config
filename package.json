{
  "name": "pi-config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "oxfmt extensions --check",
    "check:lint": "oxlint extensions",
    "check:test": "node --test extensions/guardrails/tests/*.test.ts extensions/tests/*.test.ts",
    "check:types": "tsc --noEmit",
    "format": "oxfmt extensions"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.17.0"
}
