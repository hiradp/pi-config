{
  "lastChangelogVersion": "0.84.1",
  "theme": "rustic-light/dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "anthropic/claude-fable-5",
    "anthropic/claude-opus-5",
    "anthropic/claude-sonnet-5",
    "fireworks/accounts/fireworks/models/kimi-k3",
    "fireworks/accounts/fireworks/models/glm-5p2",
    "xai/grok-4.5"
  ],
  "quietStartup": true,
  "editorPaddingX": 1,
  "guardrails": {
    "commands": {
      "blocked": ["wrangler"]
    },
    "defaultBranch": {
      "allowed": ["hiradp/*"]
    },
    "paths": {
      "blocked": [".git", ".git/**", "~/.ssh"],
      "confirm": [".env", ".env.*", ".pi", ".pi/**", "~/.ssh/**"]
    },
    "semanticReview": {
      "enabled": true,
      "mode": "enforce",
      "model": "openai-codex/gpt-5.6-luna",
      "timeoutMs": 15000,
      "commands": [
        "aws",
        "docker push",
        "gcloud",
        "gh",
        "git push",
        "npm publish",
        "pnpm publish",
        "pulumi",
        "terraform",
        "pskube",
        "k",
        "kubectl"
      ],
      "paths": [
        ".github/workflows",
        ".github/workflows/**",
        ".circleci",
        ".circleci/**",
        ".gitlab-ci.yml"
      ]
    },
    "kubectl": {
      "invocations": [
        {
          "command": "kubectl"
        },
        {
          "command": "k"
        },
        {
          "command": "pskube",
          "skipArguments": 1
        }
      ],
      "allowedCommands": [
        "api-resources",
        "api-versions",
        "auth can-i",
        "auth whoami",
        "completion",
        "config current-context",
        "config get-contexts",
        "config view",
        "describe",
        "explain",
        "get",
        "help",
        "logs",
        "options",
        "rollout history",
        "rollout status",
        "top",
        "version",
        "wait"
      ]
    }
  },
  "tuiMode": "fullscreen",
  "treeFilterMode": "default",
  "transport": "auto",
  "steeringMode": "one-at-a-time",
  "compaction": {
    "enabled": true
  },
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "ask"
}

